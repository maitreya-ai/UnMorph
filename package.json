{
  "name": "unmorph",
  "version": "0.1.0",
  "private": true,
  "description": "UnMorph — decentralized image integrity & authentication layer.",
  "scripts": {
    "preinstall": "node scripts/enforce-bun.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium",
    "prepare": "husky",
    "spike": "tsx scripts/world-spike.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{ts,tsx}": [
      "jest --bail --findRelatedTests --passWithNoTests"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@worldcoin/idkit-core": "4.6.0",
    "@noble/hashes": "1.8.0",
    "clsx": "^2.1.1",
    "lenis": "1.3.27",
    "lucide-react": "^1.69.0",
    "motion": "14.9.1",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "qrcode": "1.5.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/qrcode": "1.5.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "4.20.5",
    "typescript": "^5"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.2",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
